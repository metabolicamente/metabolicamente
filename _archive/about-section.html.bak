        </div>
        <div class="pyr-vs">vs</div>
        <div class="pyr-side ok">
          <div class="pyr-title">Our approach</div>
          <div class="pyr-sub">Treats the roots</div>
          <svg class="pyr-svg" id="pyr2"></svg>
        </div>
      </div>
    </div>
  </section>

==================== CSS ====================
body.dark .pyr-card{background:linear-gradient(180deg,#112F3B,#0E2831)}
/* pyramids */
.pyr-row{display:grid;grid-template-columns:1fr 1fr;gap:34px;margin-top:54px}
@media(max-width:820px){.pyr-row{grid-template-columns:1fr}}
.pyr-scene{display:flex;align-items:flex-start;justify-content:center;gap:14px;margin-top:50px}
.pyr-side{flex:1;max-width:480px;display:flex;flex-direction:column;align-items:center}
.pyr-side.ok .pyr-title{color:var(--t500)}
.pyr-vs{align-self:center;font-family:'Caveat',cursive;font-size:27px;color:#bcae93;padding:0 6px;flex-shrink:0}
body.dark .pyr-vs{color:#6f8a8f}
@media(max-width:820px){.pyr-scene{flex-direction:column;align-items:center;gap:26px}.pyr-vs{padding:0}}
.pyr-card{position:relative;background:linear-gradient(180deg,#fff,#FDFBF5);border:1px solid var(--line);border-radius:26px;padding:40px 30px 30px;box-shadow:0 2px 4px rgba(12,51,63,.03),0 16px 44px rgba(12,51,63,.07);transition:transform .3s ease,box-shadow .3s ease}
.pyr-card:hover{transform:translateY(-4px);box-shadow:0 4px 8px rgba(12,51,63,.04),0 24px 60px rgba(12,51,63,.1)}
.pyr-card.hl{border-color:rgba(42,157,143,.4);box-shadow:0 2px 4px rgba(12,51,63,.04),0 18px 52px rgba(42,157,143,.13)}
.ours{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--t500);color:#fff;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:6px 16px;border-radius:99px;box-shadow:0 6px 16px rgba(42,157,143,.35);white-space:nowrap}
.pyr-title{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--soft);text-align:center;margin-bottom:10px}
.pyr-card.hl .pyr-title,.pyr-side.ok .pyr-title{color:var(--t500)}
.pyr-sub{font-family:var(--serif);font-size:19px;color:var(--hd);text-align:center;margin-bottom:26px;line-height:1.3}
.pyr-svg{width:100%;max-width:430px;margin:0 auto;display:block;overflow:visible;color:#26383f}
body.dark .pyr-svg{color:#EDE6D8}
.pyr-svg .growg{opacity:0;transform:translateY(16px);transition:opacity .7s ease .1s,transform .95s cubic-bezier(.3,1.4,.45,1) .1s;transform-box:fill-box;transform-origin:center bottom}
.pyr-card.in .growg,.pyr-scene.in .growg{opacity:1;transform:none}
.pyr-svg .bandg{opacity:0;transform:translateY(34px) scale(.94);transition:opacity .6s ease,transform 1s cubic-bezier(.3,1.45,.45,1);transform-box:fill-box;transform-origin:center bottom}
.pyr-card.in .bandg{opacity:1;transform:none}
.pyr-svg .bandg:hover{transform:translateY(-5px)}
.pyr-svg .ring{opacity:0;transition:opacity 1.4s ease .8s}
.pyr-card.in .ring{opacity:1}
.pyr-svg text{pointer-events:none}

==================== JS ====================
/* ============ LANDING: pyramids ============ */
function roundedTrap(x1t,x2t,y1,x1b,x2b,y2,r){
  // trapezoid with rounded corners (top-left, top-right, bottom-right, bottom-left)
  return `M ${x1t+r} ${y1}
    L ${x2t-r} ${y1} Q ${x2t} ${y1} ${x2t+r*0.55} ${y1+r}
    L ${x2b-r*0.55} ${y2-r} Q ${x2b} ${y2} ${x2b-r} ${y2}
    L ${x1b+r} ${y2} Q ${x1b} ${y2} ${x1b+r*0.55} ${y2-r}
    L ${x1t-r*0.55} ${y1+r} Q ${x1t} ${y1} ${x1t+r} ${y1} Z`;
}
function pyramid(el,bands){
  const W=360,H=250,cx=W/2,wTop=158,wBase=330,r=11;
  const hw=y=>wTop/2+(wBase/2-wTop/2)*(y/H);
  const ys=[[6,74],[84,156],[166,244]];
  const delays=['.68s','.4s','.12s']; // foundation rises first
  const svg=document.getElementById(el);
  let inner='<defs>'+bands.map((b,i)=>
    `<linearGradient id="${el}-g${i}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="${b.c1}"/><stop offset="1" stop-color="${b.c2}"/>
    </linearGradient>`).join('')+
    `<filter id="${el}-sh" x="-30%" y="-30%" width="160%" height="170%">
      <feDropShadow dx="0" dy="7" stdDeviation="7" flood-color="#0C333F" flood-opacity="0.22"/>
    </filter>
    <linearGradient id="${el}-shine" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".35"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>`+'</defs>';
  // faint concentric arcs behind, for depth
  inner+=`<g class="ring">`+[190,230,270].map(rr=>
    `<circle cx="${cx}" cy="${H+10}" r="${rr/1.6}" fill="none" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 7"/>`).join('')+`</g>`;
  inner+=bands.map((b,i)=>{
    const [y1,y2]=ys[i];
    const p=roundedTrap(cx-hw(y1),cx+hw(y1),y1,cx-hw(y2),cx+hw(y2),y2,r);
    const shine=roundedTrap(cx-hw(y1),cx+hw(y1),y1,cx-hw(y1+(y2-y1)*.42),cx+hw(y1+(y2-y1)*.42),y1+(y2-y1)*.42,r);
    const ty=(y1+y2)/2+(b.sub?-1:7);
    return `<g class="bandg" style="transition-delay:${delays[i]}">
      <path d="${p}" fill="url(#${el}-g${i})" filter="url(#${el}-sh)"/>
      <path d="${shine}" fill="url(#${el}-shine)" opacity=".3"/>
      <text x="${cx}" y="${ty}">${b.label}${b.sub?`<tspan class="sub" x="${cx}" dy="21">${b.sub}</tspan>`:''}</text>
    </g>`;
  }).join('');
  svg.setAttribute('viewBox',`0 0 ${W} ${H+22}`);
  svg.innerHTML=inner;
}
/* ---- hand-drawn sprouts (fragile vs thriving) ---- */
(function(){
  const NS='http://www.w3.org/2000/svg';
  const coral='#E76F51', teal5='#2A9D8F', green='#7C9A86', gray='#9AA79C';
  function stem(t,rc,x1,y1,x2,y2,cxp,w,col){ t.appendChild(rc.path(`M ${x1} ${y1} Q ${cxp} ${(y1+y2)/2} ${x2} ${y2}`,{roughness:1.8,bowing:1.2,stroke:col,strokeWidth:w})); }
  function leaf(t,rc,ax,ay,ang,len,fill,stroke,wf){
    const c=Math.cos(ang),s=Math.sin(ang),nx=-s,ny=c,wd=len*(wf||0.36),ex=ax+c*len,ey=ay+s*len;
    const d=`M ${ax} ${ay} Q ${ax+c*len*0.5+nx*wd} ${ay+s*len*0.5+ny*wd} ${ex} ${ey} Q ${ax+c*len*0.5-nx*wd} ${ay+s*len*0.5-ny*wd} ${ax} ${ay} Z`;
    t.appendChild(rc.path(d,{roughness:1.7,bowing:1.6,stroke:stroke,strokeWidth:1.8,fill:fill||'none',fillStyle:'hachure',fillWeight:1.3,hachureGap:5}));
  }
  function root(t,rc,x1,y1,x2,y2,w,col,br){
    t.appendChild(rc.path(`M ${x1} ${y1} Q ${x1+(x2-x1)*0.3} ${y1+(y2-y1)*0.6} ${x2} ${y2}`,{roughness:2.6,bowing:3,stroke:col,strokeWidth:w}));
    if(br){const bx=x2+(x2>x1?12:-12),by=y2+14;t.appendChild(rc.line(x2,y2,bx,by,{roughness:2.4,bowing:2,stroke:col,strokeWidth:Math.max(1.2,w-0.8)}));}
  }
  function ground(t,rc,x1,x2,y,col){ t.appendChild(rc.line(x1,y,x2,y,{roughness:2.2,bowing:1,stroke:col,strokeWidth:2.4})); }
  function tx(t,x,y,s,col,size){ const e=document.createElementNS(NS,'text'); e.setAttribute('x',x); e.setAttribute('y',y); e.setAttribute('text-anchor','middle'); e.setAttribute('font-family',"'Caveat',cursive"); e.setAttribute('font-size',size||16); e.setAttribute('font-weight',700); e.setAttribute('fill',col); e.textContent=s; t.appendChild(e); }
  function sprout(id,strong){
    const svg=document.getElementById(id); if(!svg||!window.rough) return;
    svg.setAttribute('viewBox','0 10 360 330'); svg.innerHTML='';
    const g=document.createElementNS(NS,'g'); g.setAttribute('class','growg'); svg.appendChild(g);
    const rc=rough.svg(svg), cx=180, gy=176, cc='currentColor';
    const soil=strong?coral:gray;
    g.appendChild(rc.line(40,gy,320,gy,{roughness:2.4,stroke:cc,strokeWidth:2.4}));
    const topY=strong?58:92;
    g.appendChild(rc.line(cx,gy,cx,topY,{roughness:2.2,bowing:strong?1:3,stroke:cc,strokeWidth:2.6}));
    const lf=(dir,ly)=>{ g.appendChild(rc.path(`M ${cx} ${ly} q ${dir*34} -14 ${dir*46} 10 q ${-dir*14} 10 ${-dir*46} -10 z`,{roughness:2,stroke:cc,strokeWidth:2,fill:strong?teal5:'none',fillStyle:'hachure',fillWeight:1.4,hachureGap:6})); };
    if(strong){ lf(1,topY+26); lf(-1,topY+46); lf(1,topY+66);
      g.appendChild(rc.circle(cx,topY-4,20,{roughness:1.8,stroke:coral,fill:coral,fillStyle:'solid'}));
    } else { lf(-1,topY+18); lf(1,topY+34); }
    const rootN=strong?7:3;
    for(let i=0;i<rootN;i++){
      const spread=strong?150:70;
      const ex=cx+(i-(rootN-1)/2)*(spread/rootN)*2 + (i%2?8:-8);
      const ey=gy+ (strong? 70+(i%3)*14 : 34+(i%2)*8);
      g.appendChild(rc.line(cx,gy,ex,ey,{roughness:2.6,bowing:3,stroke:soil,strokeWidth:strong?2.4:1.6}));
      if(strong && i%2===0) g.appendChild(rc.line(ex,ey,ex+(i%4?12:-12),ey+16,{roughness:2.6,bowing:3,stroke:soil,strokeWidth:1.8}));
    }
    tx(g,cx,topY-(strong?28:16), strong?'thriving':'fragile', strong?cc:gray, 16);
    tx(g,cx,gy+(strong?150:66), strong?'metabolic foundation':'metabolism ignored', strong?'#C9573C':gray, strong?17:15);
  }
  window.__drawSprouts=function(){ sprout('pyr1',false); sprout('pyr2',true); };
  __drawSprouts();
})();
